{
  "name": "brainee",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-dev.mjs && turbo run dev",
    "demo": "pnpm games:build && pnpm db:reset && DEMO_MODE=1 BRAINEE_LAB=1 pnpm --filter @brainee/web dev",
    "build": "pnpm games:build && turbo run build",
    "start": "pnpm --filter @brainee/web start",
    "e2e": "pnpm build && pnpm --filter @brainee/web e2e",
    "e2e:full": "pnpm build && pnpm --filter @brainee/web e2e:full",
    "report": "node scripts/report.mjs",
    "test:reports": "node --test scripts/reports/*.test.mjs",
    "test": "pnpm games:discover && turbo run test && pnpm test:remote-games",
    "db:push": "pnpm --filter @brainee/db db:push",
    "db:prepare": "pnpm --filter @brainee/db db:prepare",
    "db:seed": "pnpm --filter @brainee/db db:seed",
    "db:reset": "pnpm --filter @brainee/db db:reset",
    "db:refresh-demo": "pnpm --filter @brainee/db db:refresh-demo",
    "db:studio": "pnpm --filter @brainee/db db:studio",
    "check": "biome check . && pnpm check:games && pnpm check:manifests && pnpm check:palette && pnpm typecheck",
    "format": "biome format --write .",
    "typecheck": "pnpm games:discover && turbo run typecheck",
    "check:games": "node packages/games/scripts/check-games.mjs",
    "games:build": "node scripts/build-games.mjs",
    "test:assets": "node scripts/check-manifests.mjs --assets",
    "check:manifests": "node scripts/check-manifests.mjs",
    "check:palette": "node scripts/check-game-palette.mjs",
    "check:films": "pnpm --filter @brainee/films test",
    "games:discover": "node scripts/discover-games.mjs",
    "postinstall": "node scripts/discover-games.mjs",
    "games:publish": "node scripts/publish-games.mjs",
    "test:remote-games": "node --test scripts/publish-games.test.mjs",
    "test:game": "node scripts/test-game.mjs",
    "test:games": "node scripts/test-game.mjs --all"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "next": "16.4.6",
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  }
}
