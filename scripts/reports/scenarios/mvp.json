  "flows": [
    {
      "name": "phone-mvp",
      "title": "Phone: parent preview, entry, leisure, video quiz, gifts, Brainy, Path, parent",
      "viewport": "phone",
      "start": "/login",
      "steps": [
        {
          "call": "resetDemo"
        },
        {
          "mark": "Parent preview: cover and real growth stages"
        },
        {
          "goto": "/start?tour=1#cover"
        },
        {
          "expect": {
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Give screen time a happy ending.",
              "exact": true
            },
            "timeout": 20000
          }
        },
        {
          "call": "checkSurface"
        },
        {
          "wait": 1200
        },
        {
          "click": {
            "by": "role",
            "role": "button",
            "name": "Meet Brainy",
            "exact": true
          }
        },
        {
          "expect": {
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Meet Brainy.",
              "exact": true
            },
            "timeout": 20000
          }
        },
        {
          "click": {
            "by": "role",
            "role": "button",
            "name": "Continue",
            "exact": true
          }
        },
        {
          "expect": {
            "target": {
              "by": "testId",
              "value": "funnel-growth"
            },
            "timeout": 20000
          }
        },
        {
          "call": "previewGrowth"
        },
        {
          "call": "checkSurface"
        },
        {
          "goto": "/entry"
        },
        {
          "expect": {
            "url": "^/entry$",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "What are we playing now?",
              "exact": true
            },
            "timeout": 20000,
            "message": "Opening the app shows the entry screen"
          }
        },
        {
          "wait": 1800
        },
        {
          "mark": "Child: other games → Learn"
        },
        {
          "click": {
            "by": "role",
            "role": "link",
            "name": "No, I want to see other games",
            "exact": true
          }
        },
        {
          "expect": {
            "url": "^/learn$",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Brainy recommends",
              "exact": true
            },
            "message": "Learn shows Brainy's advice and the grid"
          }
        },
        {
          "wait": 1200
        },
        {
          "mark": "Leisure: shop, cartoons, science"
        },
        {
          "click": {
            "by": "role",
            "role": "link",
            "name": "Leisure",
            "exact": true
          }
        },
        {
          "expect": {
            "url": "^/leisure$",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Games for stars",
              "exact": true
            },
            "message": "Leisure shows the ★ shop"
          }
        },
        {
          "scroll": {
            "y": 700
          }
        },
        {
          "wait": 800
        },
        {
          "scroll": {
            "y": 900
          }
        },
        {
          "wait": 800
        },
        {
          "mark": "Science video: pause-only player and quiz"
        },
        {
          "click": {
            "by": "role",
            "role": "link",
            "name": "How Bees Live"
          }
        },
        {
          "expect": {
            "url": "^/video/bees$",
            "target": {
              "by": "role",
              "role": "button",
              "name": "Watch",
              "exact": true
            },
            "message": "The player has only play/pause"
          }
        },
        {
          "click": {
            "by": "role",
            "role": "button",
            "name": "Watch",
            "exact": true
          }
        },
        {
          "expect": {
            "target": {
              "by": "testId",
              "value": "video-quiz"
            },
            "timeout": 30000,
            "message": "The quiz appears after the last minute"
          }
        },
        {
          "click": {
            "by": "role",
            "role": "button",
            "name": "Wax",
            "exact": true
          }
        },
        {
          "wait": 900
        },
        {
          "click": {
            "by": "role",
            "role": "button",
            "name": "Honey",
            "exact": true
          }
        },
        {
          "expect": {
            "target": {
              "by": "text",
              "value": "Correct! +15★ and Eyes +2"
            },
            "message": "Correct answer pays +15★ once"
          }
        },
        {
          "wait": 1200
        },
        {
          "click": {
            "by": "role",
            "role": "link",
            "name": "Back to Leisure",
            "exact": true
          }
        },
        {
          "mark": "Gifts: goal, shop, tasks, exchange"
        },
        {
          "click": {
            "by": "role",
            "role": "link",
            "name": "Gifts",
            "exact": true
          }
        },
        {
          "expect": {
            "url": "^/gifts$",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Tasks from Mom",
              "exact": true
            },
            "message": "Gifts shows the weekly goal and tasks"
          }
        },
        {
          "scroll": {
            "y": 600
          }
        },
        {
          "call": "childTaskDone"
        },
        {
          "click": {
            "by": "role",
            "role": "button",
            "name": "1 ☀ for 10 ★",
            "exact": true
          }
        },
        {
          "wait": 1000
        },
        {
          "mark": "Brainy: accessory shop"
        },
        {
          "click": {
            "by": "role",
            "role": "link",
            "name": "Brainy",
            "exact": true
          }
        },
        {
          "expect": {
            "url": "^/brainy$",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Accessories",
              "exact": true
            },
            "message": "Brainy tab shows stats and the shop"
          }
        },
        {
          "call": "buyCheapestAccessory"
        },
        {
          "wait": 1200
        },
        {
          "mark": "Path: weekly learning, growth stages and discoveries"
        },
        {
          "click": {
            "by": "role",
            "role": "link",
            "name": "Path",
            "exact": true
          }
        },
        {
          "expect": {
            "url": "^/path$",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Your growing world",
              "exact": true
            },
            "message": "Path shows the stage journey and discoveries"
          }
        },
        {
          "call": "checkSurface"
        },
        {
          "call": "scrollPage"
        },
        {
          "mark": "Parent: PIN, analytics, confirm the child's task"
        },
        {
          "goto": "/analytics"
        },
        {
          "expect": {
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Parent login",
              "exact": true
            },
            "message": "Parent mode is behind a PIN"
          }
        },
        {
          "click": {
            "by": "role",
            "role": "button",
            "name": "Digit 1",
            "exact": true
          }
        },
        {
          "click": {
            "by": "role",
            "role": "button",
            "name": "Digit 2",
            "exact": true
          }
        },
        {
          "click": {
            "by": "role",
            "role": "button",
            "name": "Digit 3",
            "exact": true
          }
        },
        {
          "click": {
            "by": "role",
            "role": "button",
            "name": "Digit 4",
            "exact": true
          }
        },
        {
          "expect": {
            "target": {
              "by": "role",
              "role": "img",
              "name": "Skills",
              "exact": true
            },
            "message": "Analytics: radars, bars, ranking"
          }
        },
        {
          "wait": 1000
        },
        {
          "call": "scrollPage"
        },
        {
          "click": {
            "by": "role",
            "role": "button",
            "name": "City",
            "exact": true
          }
        },
        {
          "wait": 800
        },
        {
          "call": "openParentTab",
          "args": {
            "name": "Tasks"
          }
        },
        {
          "expect": {
            "url": "^/tasks$",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Today",
              "exact": true
            },
            "message": "Tasks: Today list with confirmations"
          }
        },
        {
          "call": "confirmTask"
        },
        {
          "call": "scrollPage"
        },
        {
          "call": "openParentTab",
          "args": {
            "name": "Gifts & goal"
          }
        },
        {
          "expect": {
            "url": "^/rewards$",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Gift shop",
              "exact": true
            },
            "message": "Gifts & goal: requests and shop"
          }
        },
        {
          "call": "scrollPage"
        }
      ]
    },
