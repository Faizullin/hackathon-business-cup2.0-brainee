{
  "shots": [
    {
      "route": "/start?tour=1#duration",
      "shots": [
        {
          "name": "start-quiz",
          "fullPage": true,
          "steps": [
            {
              "expect": {
                "target": {
                  "by": "testId",
                  "value": "brain-panel"
                },
                "timeout": 20000
              }
            },
            {
              "expect": {
                "eval": "document.querySelector('[data-testid=\"parent-funnel\"]')?.dataset.step === \"duration\"",
                "timeout": 25000
              }
            },
            {
              "expect": {
                "eval": "document.documentElement.lang === \"en\" && document.documentElement.scrollWidth <= window.innerWidth",
                "message": "English screen fits the viewport"
              }
            }
          ]
        }
      ]
    },
    {
