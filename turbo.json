{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        ".next-games/**",
        "!.next-games/cache/**",
        "!.next-games/dev/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "DEMO_MODE",
    "BRAINEE_LAB",
    "DATABASE_URL",
    "DATABASE_AUTH_TOKEN",
    "BRAINEE_DEFAULT_LOCALE",
    "BRAINEE_NEXT_DIR"
  ]
}
