{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "games/*/manifest.json",
    "games/*/preview.json",
    "packages/games/src/*/manifest.json"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        ".next-games/**",
        "!.next-games/cache/**",
        "!.next-games/dev/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "DEMO_MODE",
    "BRAINEE_SHARED_DEMO",
    "BRAINEE_LAB",
    "DATABASE_URL",
    "DATABASE_AUTH_TOKEN",
    "REMOTE_GAMES_DRIVER",
    "REMOTE_GAMES_DIR",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "R2_ENDPOINT",
    "R2_BUCKET_NAME",
    "R2_ENDPOINT_URL"
  ],
  "globalEnv": ["BRAINEE_NEXT_DIR"]
}
