{
  "name": "@brainee/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": "./schema.ts",
    "./seed": {
      "types": "./src/showcase-seed.ts",
      "default": "./src/showcase-seed.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/manage.ts push",
    "db:seed": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/manage.ts seed",
    "db:refresh-demo": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/manage.ts refresh-demo",
    "db:reset": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/manage.ts reset",
    "db:studio": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/manage.ts studio"
  },
  "dependencies": {
    "@brainee/core": "workspace:*",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4",
    "@brainee/game-catalog": "workspace:*"
  },
  "devDependencies": {
    "@brainee/config": "workspace:*",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
