# Copy to apps/web/.env.local. Paths resolve from the workspace root.
# `pnpm dev` creates and seeds a missing local file; `pnpm db:reset` recreates it.
DATABASE_URL=file:./data/dev.db
# Only for a remote libSQL/Turso URL (the deployed demo). Never commit a real token.
# DATABASE_AUTH_TOKEN=
# Required for every child/parent screen and API: demo families, jury entry and the funnel's
# one-tap start. There is no non-demo auth yet (D-07).
DEMO_MODE=1
# The /lab game harness is always on in `next dev`; set to 1 to expose it in a production build.
BRAINEE_LAB=0
