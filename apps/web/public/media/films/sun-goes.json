  "questions": [
    {
      "t": 134.16,
      "q": "What do you see out of the rocket window?",
      "options": ["The sun", "The moon", "A rainbow"],
      "answer": 0,
      "hint": "Almost! It is big, bright and yellow.",
      "praise": "Yes! It's the sun, shining in space.",
